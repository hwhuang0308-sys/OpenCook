{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencook:project-config",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "shell": { "type": "string" },
    "model": {
      "anyOf": [
        { "type": "string", "pattern": "^[^/#]+\\/[^#]+(?:#[^#]+)?$" },
        {
          "type": "object",
          "properties": {
            "providerID": { "type": "string", "pattern": "^[^/#]+$" },
            "model": { "type": "string", "pattern": "^[^#]+$" },
            "variant": { "type": "string", "pattern": "^[^#]+$" }
          },
          "required": ["providerID", "model"],
          "additionalProperties": false
        }
      ]
    },
    "default_agent": { "type": "string" },
    "update": { "type": "string", "enum": ["disable", "notify", "auto"] },
    "share": { "type": "string", "enum": ["manual", "auto", "disabled"] },
    "enterprise": {
      "type": "object",
      "properties": { "url": { "type": "string" } },
      "additionalProperties": false
    },
    "username": { "type": "string" },
    "permissions": { "$ref": "#/$defs/Permission.Ruleset" },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["provider.use", "tool.use", "integration.use"]
          },
          "resource": { "type": "string" },
          "effect": { "type": "string", "enum": ["allow", "deny"] }
        },
        "required": ["action", "resource", "effect"],
        "additionalProperties": false
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/Config.AgentEncoded" }
    },
    "snapshots": { "type": "boolean" },
    "watcher": {
      "type": "object",
      "properties": {
        "ignore": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "formatter": {
      "anyOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Config.Formatter.EntryEncoded"
          }
        }
      ]
    },
    "lsp": {
      "anyOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "disabled": { "type": "boolean", "enum": [true] }
                },
                "required": ["disabled"],
                "additionalProperties": false
              },
              { "$ref": "#/$defs/Config.LSP.ServerEncoded" }
            ]
          }
        }
      ]
    },
    "media": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "auto_resize": { "type": "boolean" },
            "max_width": { "type": "integer", "exclusiveMinimum": 0 },
            "max_height": { "type": "integer", "exclusiveMinimum": 0 },
            "max_base64_bytes": { "type": "integer", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tool_output": {
      "type": "object",
      "properties": {
        "max_lines": { "type": "integer", "exclusiveMinimum": 0 },
        "max_bytes": { "type": "integer", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "object",
          "properties": {
            "startup": { "type": "integer", "exclusiveMinimum": 0 },
            "catalog": { "type": "integer", "exclusiveMinimum": 0 },
            "execution": { "type": "integer", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "servers": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "$ref": "#/$defs/Mcp.LocalConfigEncoded" },
              { "$ref": "#/$defs/Mcp.RemoteConfigEncoded" }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "compaction": {
      "type": "object",
      "properties": {
        "auto": { "type": "boolean" },
        "keep": {
          "type": "object",
          "properties": { "tokens": { "type": "integer", "minimum": 0 } },
          "additionalProperties": false
        },
        "buffer": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "skills": { "type": "array", "items": { "type": "string" } },
    "commands": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/Config.CommandEncoded" }
    },
    "instructions": { "type": "array", "items": { "type": "string" } },
    "references": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          { "type": "string" },
          { "$ref": "#/$defs/Config.Reference.GitEncoded" },
          { "$ref": "#/$defs/Config.Reference.LocalEncoded" }
        ]
      }
    },
    "websearch": {
      "anyOf": [
        { "type": "boolean", "enum": [false] },
        { "$ref": "#/$defs/ConfigWebSearch.InfoEncoded" }
      ]
    },
    "plugins": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          { "$ref": "#/$defs/Config.Plugin.EntryEncoded" }
        ]
      }
    },
    "worktree": { "$ref": "#/$defs/Config.Worktree" },
    "warming": {
      "anyOf": [
        { "type": "boolean" },
        { "$ref": "#/$defs/Config.WarmingEncoded" }
      ]
    },
    "providers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/Config.ProviderEncoded" }
    },
    "experimental": {
      "type": "object",
      "properties": {
        "portable_shell_scanner": { "type": "boolean" },
        "subagent_depth": { "type": "integer", "minimum": 0 },
        "policies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": ["provider.use", "tool.use", "integration.use"]
              },
              "resource": { "type": "string" },
              "effect": { "type": "string", "enum": ["allow", "deny"] }
            },
            "required": ["action", "resource", "effect"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "cooking_models": {
      "type": "object",
      "properties": {
        "chat": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "base_url": { "type": "string" },
            "model": { "type": "string" },
            "context": { "type": "integer", "exclusiveMinimum": 0 },
            "output": { "type": "integer", "exclusiveMinimum": 0 },
            "voice": { "type": "string" },
            "speed": { "type": "number", "minimum": 0.25, "maximum": 4 },
            "api_key": { "type": "string" }
          },
          "required": ["enabled", "base_url", "model", "context", "output"],
          "additionalProperties": false
        },
        "vision": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "base_url": { "type": "string" },
            "model": { "type": "string" },
            "context": { "type": "integer", "exclusiveMinimum": 0 },
            "output": { "type": "integer", "exclusiveMinimum": 0 },
            "voice": { "type": "string" },
            "speed": { "type": "number", "minimum": 0.25, "maximum": 4 },
            "api_key": { "type": "string" }
          },
          "required": ["enabled", "base_url", "model", "context", "output"],
          "additionalProperties": false
        },
        "speech": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "base_url": { "type": "string" },
            "model": { "type": "string" },
            "context": { "type": "integer", "exclusiveMinimum": 0 },
            "output": { "type": "integer", "exclusiveMinimum": 0 },
            "voice": { "type": "string" },
            "speed": { "type": "number", "minimum": 0.25, "maximum": 4 },
            "api_key": { "type": "string" }
          },
          "required": ["enabled", "base_url", "model", "context", "output"],
          "additionalProperties": false
        },
        "embedding": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "base_url": { "type": "string" },
            "model": { "type": "string" },
            "context": { "type": "integer", "exclusiveMinimum": 0 },
            "output": { "type": "integer", "exclusiveMinimum": 0 },
            "voice": { "type": "string" },
            "speed": { "type": "number", "minimum": 0.25, "maximum": 4 },
            "api_key": { "type": "string" }
          },
          "required": ["enabled", "base_url", "model", "context", "output"],
          "additionalProperties": false
        },
        "rerank": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "base_url": { "type": "string" },
            "model": { "type": "string" },
            "context": { "type": "integer", "exclusiveMinimum": 0 },
            "output": { "type": "integer", "exclusiveMinimum": 0 },
            "voice": { "type": "string" },
            "speed": { "type": "number", "minimum": 0.25, "maximum": 4 },
            "api_key": { "type": "string" }
          },
          "required": ["enabled", "base_url", "model", "context", "output"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Permission.Effect": { "type": "string", "enum": ["allow", "deny", "ask"] },
    "Permission.Rule": {
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "resource": { "type": "string" },
        "effect": { "$ref": "#/$defs/Permission.Effect" }
      },
      "required": ["action", "resource", "effect"],
      "additionalProperties": false
    },
    "Permission.Ruleset": {
      "type": "array",
      "items": { "$ref": "#/$defs/Permission.Rule" }
    },
    "Config.AgentEncoded": {
      "type": "object",
      "properties": {
        "model": {
          "anyOf": [
            { "type": "string", "pattern": "^[^/#]+\\/[^#]+(?:#[^#]+)?$" },
            {
              "type": "object",
              "properties": {
                "providerID": { "type": "string", "pattern": "^[^/#]+$" },
                "model": { "type": "string", "pattern": "^[^#]+$" },
                "variant": { "type": "string", "pattern": "^[^#]+$" }
              },
              "required": ["providerID", "model"],
              "additionalProperties": false
            }
          ]
        },
        "request": {
          "type": "object",
          "properties": {
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "body": { "type": "object" }
          },
          "additionalProperties": false
        },
        "system": { "type": "string" },
        "description": { "type": "string" },
        "mode": { "type": "string", "enum": ["subagent", "primary", "all"] },
        "hidden": { "type": "boolean" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "steps": { "type": "integer", "exclusiveMinimum": 0 },
        "disabled": { "type": "boolean" },
        "permissions": { "$ref": "#/$defs/Permission.Ruleset" }
      },
      "additionalProperties": false
    },
    "Config.Formatter.EntryEncoded": {
      "type": "object",
      "properties": {
        "disabled": { "type": "boolean" },
        "command": { "type": "array", "items": { "type": "string" } },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "extensions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "Config.LSP.ServerEncoded": {
      "type": "object",
      "properties": {
        "command": { "type": "array", "items": { "type": "string" } },
        "extensions": { "type": "array", "items": { "type": "string" } },
        "disabled": { "type": "boolean" },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "initialization": { "type": "object" }
      },
      "required": ["command"],
      "additionalProperties": false
    },
    "Mcp.Protocol": {
      "type": "string",
      "enum": ["legacy", "auto", "2026-07-28"],
      "description": "MCP protocol negotiation. \"legacy\" (default) opens with the initialize handshake and speaks protocol revisions up to 2025-11-25. \"auto\" probes for the 2026-07-28 revision and falls back to legacy when the server does not support it. \"2026-07-28\" requires that revision and fails otherwise."
    },
    "Mcp.LocalConfigEncoded": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["local"] },
        "command": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "disabled": { "type": "boolean" },
        "codemode": { "type": "boolean" },
        "timeout": {
          "type": "object",
          "properties": {
            "startup": { "type": "integer", "exclusiveMinimum": 0 },
            "catalog": { "type": "integer", "exclusiveMinimum": 0 },
            "execution": { "type": "integer", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "protocol": { "$ref": "#/$defs/Mcp.Protocol" }
      },
      "required": ["type", "command"],
      "additionalProperties": false
    },
    "Mcp.OAuthConfigEncoded": {
      "type": "object",
      "properties": {
        "client_id": { "type": "string" },
        "client_secret": { "type": "string" },
        "scope": { "type": "string" },
        "callback_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "redirect_uri": { "type": "string" },
        "auth_server_metadata_url": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Mcp.RemoteConfigEncoded": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["remote"] },
        "url": { "type": "string" },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "oauth": {
          "anyOf": [
            { "$ref": "#/$defs/Mcp.OAuthConfigEncoded" },
            { "type": "boolean", "enum": [false] }
          ]
        },
        "disabled": { "type": "boolean" },
        "codemode": { "type": "boolean" },
        "timeout": {
          "type": "object",
          "properties": {
            "startup": { "type": "integer", "exclusiveMinimum": 0 },
            "catalog": { "type": "integer", "exclusiveMinimum": 0 },
            "execution": { "type": "integer", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "protocol": { "$ref": "#/$defs/Mcp.Protocol" }
      },
      "required": ["type", "url"],
      "additionalProperties": false
    },
    "Config.CommandEncoded": {
      "type": "object",
      "properties": {
        "template": { "type": "string" },
        "description": { "type": "string" },
        "agent": { "type": "string" },
        "model": {
          "anyOf": [
            { "type": "string", "pattern": "^[^/#]+\\/[^#]+(?:#[^#]+)?$" },
            {
              "type": "object",
              "properties": {
                "providerID": { "type": "string", "pattern": "^[^/#]+$" },
                "model": { "type": "string", "pattern": "^[^#]+$" },
                "variant": { "type": "string", "pattern": "^[^#]+$" }
              },
              "required": ["providerID", "model"],
              "additionalProperties": false
            }
          ]
        },
        "subagent": { "type": "boolean" },
        "subtask": {
          "type": "boolean",
          "description": "Deprecated alias for subagent."
        }
      },
      "required": ["template"],
      "additionalProperties": false
    },
    "Config.Reference.GitEncoded": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "branch": { "type": "string" },
        "description": { "type": "string" },
        "hidden": { "type": "boolean" }
      },
      "required": ["repository"],
      "additionalProperties": false
    },
    "Config.Reference.LocalEncoded": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "description": { "type": "string" },
        "hidden": { "type": "boolean" }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "WebSearch.ID": { "type": "string" },
    "ConfigWebSearch.InfoEncoded": {
      "type": "object",
      "properties": {
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["random"],
              "description": "Reuse a randomly selected provider until it is rate limited, then switch to another available provider."
            },
            { "$ref": "#/$defs/WebSearch.ID" }
          ]
        }
      },
      "required": ["provider"],
      "additionalProperties": false
    },
    "Config.Plugin.EntryEncoded": {
      "type": "object",
      "properties": {
        "package": { "type": "string" },
        "options": { "type": "object" }
      },
      "required": ["package"],
      "additionalProperties": false
    },
    "Config.Worktree": {
      "type": "object",
      "properties": { "directory": { "type": "string" } },
      "required": ["directory"],
      "additionalProperties": false
    },
    "Config.WarmingEncoded": {
      "type": "object",
      "properties": {
        "prompt": { "type": "string" },
        "interval": { "type": "string" },
        "duration": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Provider.ID": { "type": "string" },
    "Model.ReasoningField": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["reasoning", "reasoning_content", "reasoning_text"]
        },
        { "type": "string" }
      ]
    },
    "Model.MaxTokensField": {
      "type": "string",
      "enum": ["max_completion_tokens", "max_tokens"]
    },
    "Model.CacheFormat": { "type": "string", "enum": ["anthropic", "alibaba"] },
    "Provider.Compatibility": {
      "type": "object",
      "properties": {
        "reasoningField": { "$ref": "#/$defs/Model.ReasoningField" },
        "requireReasoning": { "type": "boolean" },
        "maxTokensField": { "$ref": "#/$defs/Model.MaxTokensField" },
        "requireFinishReason": { "type": "boolean" },
        "requireAssistantAfterTool": { "type": "boolean" },
        "supportsPromptCacheKey": { "type": "boolean" },
        "cacheFormat": { "$ref": "#/$defs/Model.CacheFormat" }
      },
      "additionalProperties": false
    },
    "Provider.Compaction": {
      "anyOf": [
        {
          "type": "object",
          "properties": { "type": { "type": "string", "enum": ["summary"] } },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "type": "string", "enum": ["native"] } },
          "required": ["type"],
          "additionalProperties": false
        }
      ]
    },
    "Provider.Transport": { "type": "string", "enum": ["http", "websocket"] },
    "Provider.Encoding": { "type": "string", "enum": ["zstd", "gzip", "none"] },
    "Config.Provider.Settings": {
      "type": "object",
      "properties": {
        "timeout": {
          "anyOf": [
            { "type": "number" },
            { "type": "boolean", "enum": [false] }
          ]
        },
        "headerTimeout": {
          "anyOf": [
            { "type": "number" },
            { "type": "boolean", "enum": [false] }
          ]
        },
        "chunkTimeout": {
          "anyOf": [
            { "type": "number" },
            { "type": "boolean", "enum": [false] }
          ]
        },
        "compaction": { "$ref": "#/$defs/Provider.Compaction" },
        "transport": { "$ref": "#/$defs/Provider.Transport" },
        "encoding": { "$ref": "#/$defs/Provider.Encoding" }
      },
      "allOf": [
        {
          "type": "object",
          "additionalProperties": { "anyOf": [{}, { "type": "null" }] }
        }
      ]
    },
    "Model.Compatibility": {
      "type": "object",
      "properties": {
        "reasoningField": { "$ref": "#/$defs/Model.ReasoningField" },
        "requireReasoning": { "type": "boolean" },
        "maxTokensField": { "$ref": "#/$defs/Model.MaxTokensField" },
        "requireFinishReason": { "type": "boolean" },
        "requireAssistantAfterTool": { "type": "boolean" },
        "supportsPromptCacheKey": { "type": "boolean" },
        "cacheFormat": { "$ref": "#/$defs/Model.CacheFormat" },
        "supportsThinkingBlockBinding": { "type": "boolean" },
        "supportsEffortUpdates": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "Config.Model.Settings": {
      "type": "object",
      "properties": {
        "compaction": { "$ref": "#/$defs/Provider.Compaction" },
        "encoding": { "$ref": "#/$defs/Provider.Encoding" }
      },
      "allOf": [
        {
          "type": "object",
          "additionalProperties": { "anyOf": [{}, { "type": "null" }] }
        }
      ]
    },
    "Config.Model.Reasoning": {
      "anyOf": [
        {
          "type": "object",
          "properties": { "supported": { "type": "boolean", "enum": [false] } },
          "required": ["supported"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "supported": { "type": "boolean", "enum": [true] },
            "toggle": { "type": "boolean" },
            "effort": { "type": "array", "items": { "type": "string" } },
            "budget": {
              "type": "object",
              "properties": {
                "min": { "type": "integer" },
                "max": { "type": "integer" }
              },
              "additionalProperties": false
            }
          },
          "required": ["supported"],
          "additionalProperties": false
        }
      ]
    },
    "Config.Model.Capabilities": {
      "type": "object",
      "properties": {
        "tools": { "type": "boolean" },
        "input": { "type": "array", "items": { "type": "string" } },
        "output": { "type": "array", "items": { "type": "string" } },
        "temperature": { "type": "boolean" },
        "reasoning": { "$ref": "#/$defs/Config.Model.Reasoning" }
      },
      "additionalProperties": false
    },
    "Money.USDPerMillionTokens": { "type": "number" },
    "Config.Model.CostEncoded": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["context"] },
            "size": { "type": "integer" }
          },
          "required": ["type", "size"],
          "additionalProperties": false
        },
        "input": { "$ref": "#/$defs/Money.USDPerMillionTokens" },
        "output": { "$ref": "#/$defs/Money.USDPerMillionTokens" },
        "cache": {
          "type": "object",
          "properties": {
            "read": { "$ref": "#/$defs/Money.USDPerMillionTokens" },
            "write": { "$ref": "#/$defs/Money.USDPerMillionTokens" }
          },
          "additionalProperties": false
        }
      },
      "required": ["input", "output"],
      "additionalProperties": false
    },
    "Config.ModelEncoded": {
      "type": "object",
      "properties": {
        "modelID": { "type": "string" },
        "family": { "type": "string" },
        "name": { "type": "string" },
        "releaseDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$",
          "description": "Release date as YYYY-MM-DD or YYYY-MM"
        },
        "compatibility": { "$ref": "#/$defs/Model.Compatibility" },
        "package": { "type": "string" },
